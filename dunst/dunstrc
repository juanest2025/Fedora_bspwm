[global]

### Monitor
monitor = 0
follow = mouse

### Geometría
width = 360
height = 300
origin = top-right
offset = 20x20
notification_limit = 8

### Apariencia
transparency = 0
corner_radius = 14
gap_size = 10
separator_height = 0
padding = 16
horizontal_padding = 16
text_icon_padding = 12
frame_width = 2

### Fuente
font = JetBrainsMono Nerd Font 11

### Iconos
icon_position = left
min_icon_size = 32
max_icon_size = 64

### Comportamiento
markup = full
format = "<b>%s</b>\n%b"

alignment = left
vertical_alignment = center

show_age_threshold = 60
word_wrap = yes
ignore_newline = no

sort = yes
stack_duplicates = true
hide_duplicate_count = false

sticky_history = yes
history_length = 50

mouse_left_click = close_current
mouse_middle_click = do_action
mouse_right_click = close_all

### Progreso
progress_bar = true
progress_bar_height = 8
progress_bar_corner_radius = 4
progress_bar_frame_width = 0

### Animaciones
shrink = yes

### Colores Catppuccin

[urgency_low]
background = "#1E1E2E"
foreground = "#CDD6F4"
frame_color = "#89B4FA"
highlight = "#89B4FA"
timeout = 4

[urgency_normal]
background = "#1E1E2E"
foreground = "#CDD6F4"
frame_color = "#94E2D5"
highlight = "#94E2D5"
timeout = 6

[urgency_critical]
background = "#1E1E2E"
foreground = "#F38BA8"
frame_color = "#F38BA8"
highlight = "#F38BA8"
timeout = 0
